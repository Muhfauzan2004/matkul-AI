@startuml
' UML class diagram generated for tokoobat Laravel project
skinparam classAttributeIconSize 0

package "Models" {
    class User {
        +string name
        +string email
        +string password
        +string role
        +string phone
        +string address
        +string photo
        +bool isSuperAdmin()
        +bool isAdmin()
        +bool isPemilik()
        +bool hasAdminAccess()
        +orders()
    }

    class Obat {
        +string kode
        +string nama_obat
        +int kategori_id
        +int stok
        +string satuan
        +decimal harga_umum
        +decimal harga_barang
        +decimal harga_jual_bpjs
        +string deskripsi
        +string gambar
        +bool is_active
        +bool is_approved
        +kategori()
        +orderItems()
        +generateKodeObat()
    }

    class Kategori {
        +string nama_kategori
        +string slug
        +string deskripsi
        +obat()
    }

    class Order {
        +string no_order
        +int user_id
        +string status
        +decimal total_harga
        +string alamat_pengiriman
        +string metode_pembayaran
        +string catatan
        +user()
        +items()
        +generateNoOrder()
    }

    class OrderItem {
        +int order_id
        +int obat_id
        +int jumlah
        +decimal harga_satuan
        +decimal subtotal
        +order()
        +obat()
    }

    class StockAddition {
        +int obat_id
        +int jumlah
        +string catatan
        +string status
        +obat()
    }
}

