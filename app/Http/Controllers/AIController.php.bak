<?php

namespace App\Http\Controllers;

use App\Models\AiMessage;
use App\Models\Obat;
use App\Models\AturanRekomendasiObat;
use Illuminate\Http\Request;
use Illuminate\Support\Collection;
use Illuminate\Support\Facades\Http;
use Illuminate\Support\Facades\Log;
use Illuminate\Support\Str;
use Throwable;

class AIController extends Controller
{
    /*
    |--------------------------------------------------------------------------
    | PENGATURAN AI
    |--------------------------------------------------------------------------
    */

    private string $ollamaUrl = 'http://127.0.0.1:11434/api/chat';

    private string $ollamaModel = 'qwen2.5:1.5b';

    private int $maxHistory = 16;

    /*
    |--------------------------------------------------------------------------
    | 1. ALUR UTAMA CHAT
    |--------------------------------------------------------------------------
    */

    public function chat(Request $request)
    {

        set_time_limit(180);

        $request->validate([
            'message' => 'required|string|max:2000',
        ]);

        $request->validate([
            'message' => 'required|string|max:2000',
        ]);

        $user = $request->user();

        /*
         * Nama pengguna diambil langsung dari akun yang sedang login.
         * Jadi user tidak perlu menyebutkan namanya di chat.
         */
        $namaPengguna = trim((string) ($user->name ?? ''));

        $pertanyaan = trim($request->input('message'));
        $teks = $this->normalizeText($pertanyaan);

        if ($teks === '') {
            return response()->json([
                'error' => 'Pesan tidak boleh kosong.',
            ], 422);
        }

        $riwayat = AiMessage::where('user_id', $user->id)
            ->orderByDesc('id')
            ->limit($this->maxHistory)
            ->get()
            ->reverse()
            ->values();

        AiMessage::create([
            'user_id' => $user->id,
            'role' => 'user',
            'content' => $pertanyaan,
        ]);

        /*
         * PRIORITAS 0:
         * USER MENANYAKAN NAMANYA
         *
         * Nama tidak diambil dari isi chat.
         * Nama selalu menggunakan nama akun yang sedang login.
         */
        if ($this->isNameQuestion($teks)) {
            if ($namaPengguna !== '') {
                return $this->sendReply(
                    $user,
                    "Nama kamu {$namaPengguna}. 😊"
                );
            }

            return $this->sendReply(
                $user,
                "Aku belum bisa menemukan nama akun kamu."
            );
        }

        // Data inventaris selalu diambil dari database terbaru.
        $obat = $this->getDataObat();

        /*
         * PRIORITAS 1: KEADAAN DARURAT
         */
        if ($this->hasEmergencySymptoms($teks)) {
            return $this->sendReply(
                $user,
                $this->emergencyReply()
            );
        }

        /*
         * PRIORITAS 2: DAFTAR OBAT HABIS
         */
        if ($this->isOutOfStockListRequest($teks)) {
            return $this->handleOutOfStockList($user, $obat);
        }

        /*
         * PRIORITAS 3: DAFTAR OBAT TERSEDIA
         */
        if ($this->isAvailableListRequest($teks)) {
            return $this->handleAvailableList($user, $obat);
        }

        /*
         * PRIORITAS 4: PENCARIAN OBAT
         */
        $obatCocok = $this->findMedicineInMessage($teks, $obat);

        $pertanyaanStok = $this->isStockOrPriceQuestion($teks);

        if (
            $obatCocok->isEmpty()
            && $pertanyaanStok
            && $this->hasMedicineReference($teks)
        ) {
            $obatCocok = $this->findMedicineInHistory(
                $riwayat,
                $obat
            );
        }

        if ($obatCocok->isNotEmpty() && $pertanyaanStok) {
            return $this->handleMedicineStock($user, $obatCocok);
        }

        /*
         * PRIORITAS 5: PERTANYAAN LANJUTAN TENTANG STOK
         */
        $jawabanStok = $this->handleStockFollowUp(
            $teks,
            $riwayat
        );

        if ($jawabanStok !== null) {
            return $this->sendReply($user, $jawabanStok);
        }

        /*
         * PRIORITAS 6: PERTANYAAN STOK UMUM
         */
        if (
            $this->isGeneralStockQuestion($teks)
            && $obatCocok->isEmpty()
        ) {
            return $this->handleGeneralStockQuestion($user, $obat);
        }

        /*
         * PRIORITAS 7: PERCAKAPAN RINGAN
         */
        $smallTalk = $this->handleSmallTalk($teks);

        if ($smallTalk !== null) {
            return $this->sendReply($user, $smallTalk);
        }

        /*
         * PRIORITAS 8: PEMBUKAAN KELUHAN KESEHATAN
         */
        $healthOpening = $this->handleHealthOpening($teks);

        if ($healthOpening !== null) {
            return $this->sendReply($user, $healthOpening);
        }

        /*
         * PRIORITAS 9: REKOMENDASI OBAT
         */
        if ($this->isMedicineRecommendationQuestion($teks)) {
            return $this->sendReply(
                $user,
                $this->handleMedicineRecommendation(
                    $teks,
                    $riwayat
                )
            );
        }

        /*
         * PRIORITAS 10: PERCAKAPAN KESEHATAN
         */
        $healthReply = $this->handleHealthConversation(
            $teks,
            $riwayat
        );

        if ($healthReply !== null) {
            return $this->sendReply($user, $healthReply);
        }

        /*
         * PRIORITAS 11: KIRIM KONTEKS KE OLLAMA
         */
        $history = AiMessage::where('user_id', $user->id)
            ->orderByDesc('id')
            ->limit($this->maxHistory)
            ->get()
            ->reverse()
            ->values()
            ->map(function ($message) {
                return [
                    'role' => $message->role,
                    'content' => $message->content,
                ];
            })
            ->all();

        try {
            $response = Http::timeout(120)->post(
                $this->ollamaUrl,
                [
                    'model' => $this->ollamaModel,
                    'messages' => array_merge(
                        [
                            [
                                'role' => 'system',
                                'content' => $this->buildSystemPrompt(
                                    $obat,
                                    $user
                                ),
                            ],
                        ],
                        $history
                    ),
                    'stream' => false,
                    'options' => [
                        'temperature' => 0.35,
                        'top_p' => 0.85,
                        'num_ctx' => 4096,
                        'repeat_penalty' => 1.15,
                    ],
                ]
            );

            if ($response->failed()) {
                Log::error('Ollama gagal merespons.', [
                    'status' => $response->status(),
                    'body' => $response->body(),
                ]);

                return response()->json([
                    'error' => 'AI sedang mengalami gangguan. Silakan coba lagi.',
                ], 502);
            }

            $reply = $response->json('message.content');

            if (!is_string($reply) || trim($reply) === '') {
                return response()->json([
                    'error' => 'AI belum memberikan jawaban. Silakan coba lagi.',
                ], 502);
            }

            return $this->sendReply(
                $user,
                $this->cleanAIResponse($reply)
            );

        } catch (Throwable $e) {
            Log::error('Kesalahan koneksi Ollama.', [
                'message' => $e->getMessage(),
            ]);

            return response()->json([
                'error' => 'Tidak dapat terhubung ke AI lokal. Pastikan Ollama berjalan.',
            ], 500);
        }
    }

    /*
    |--------------------------------------------------------------------------
    | 2. IDENTITAS PENGGUNA YANG LOGIN
    |--------------------------------------------------------------------------
    */

    private function isNameQuestion(string $teks): bool
    {
        return (bool) preg_match(
            '/^(?:'
            . 'siapa\s+nama\s+(?:aku|saya)'
            . '|nama\s+(?:aku|saya)\s+siapa'
            . '|namaku\s+siapa'
            . '|siapa\s+namaku'
            . '|siapa\s+nama\s+aku'
            . '|siapa\s+nama\s+saya'
            . '|apakah\s+kamu\s+tahu\s+namaku'
            . '|apakah\s+kamu\s+tahu\s+nama\s+(?:aku|saya)'
            . '|apakah\s+kamu\s+ingat\s+namaku'
            . '|apakah\s+kamu\s+ingat\s+nama\s+(?:aku|saya)'
            . '|kamu\s+tahu\s+namaku'
            . '|kamu\s+tahu\s+nama\s+(?:aku|saya)'
            . '|kamu\s+ingat\s+namaku'
            . '|kamu\s+ingat\s+nama\s+(?:aku|saya)'
            . ')[?!.\s]*$/u',
            $teks
        );
    }

    /*
    |--------------------------------------------------------------------------
    | 3. NORMALISASI TEKS
    |--------------------------------------------------------------------------
    */

    private function normalizeText(string $teks): string
    {
        $teks = mb_strtolower(trim($teks));
        $teks = preg_replace('/\s+/u', ' ', $teks);

        return $teks ?? '';
    }

    /*
    |--------------------------------------------------------------------------
    | 4. DATA INVENTARIS
    |--------------------------------------------------------------------------
    */

    private function getDataObat(): Collection
    {
        return Obat::with('kategori')
            ->where('is_active', true)
            ->where('is_approved', true)
            ->get()
            ->map(function ($item) {
                return [
                    'id' => $item->id,
                    'nama_obat' => $item->nama_obat,
                    'kategori' => $item->kategori?->nama_kategori,
                    'stok' => max(0, (int) $item->stok),
                    'satuan' => $item->satuan ?: 'Unit',
                    'harga_umum' => $item->harga_umum,
                    'deskripsi' => $item->deskripsi,
                ];
            })
            ->values();
    }

    /*
    |--------------------------------------------------------------------------
    | 5. DAFTAR OBAT HABIS
    |--------------------------------------------------------------------------
    */

    private function isOutOfStockListRequest(string $teks): bool
    {
        $menyebutObat = preg_match('/\b(obat|obat-obatan)\b/u', $teks);

        $menyebutHabis = preg_match(
            '/\b(habis|kosong|kehabisan|nihil)\b/u',
            $teks
        );

        $memintaDaftar = preg_match(
            '/\b(daftar|sebutkan|tampilkan|list|semua|apa saja|apa aja)\b/u',
            $teks
        );

        return (bool) (
            $menyebutObat
            && $menyebutHabis
            && (
                $memintaDaftar
                || preg_match(
                    '/obat\s+apa|apa\s+saja\s+obat|obat\s+mana/u',
                    $teks
                )
            )
        );
    }

    private function handleOutOfStockList($user, Collection $obat)
    {
        $habis = $obat->where('stok', '<=', 0)->values();

        if ($habis->isEmpty()) {
            return $this->sendReply(
                $user,
                'Saat ini tidak ada obat aktif dan disetujui yang tercatat habis. 😊'
            );
        }

        $reply = "Berikut obat yang stoknya sedang habis:\n\n";

        foreach ($habis as $item) {
            $reply .= "- {$item['nama_obat']} "
                . "(0 {$item['satuan']})\n";
        }

        $reply .= "\nData ini berdasarkan inventaris apotek saat ini.";

        return $this->sendReply($user, $reply);
    }

    /*
    |--------------------------------------------------------------------------
    | 6. DAFTAR OBAT TERSEDIA
    |--------------------------------------------------------------------------
    */

    private function isAvailableListRequest(string $teks): bool
    {
        return (bool) preg_match(
            '/obat.*(tersedia|ready|ada)|'
            . '(daftar|tampilkan|sebutkan).*obat|'
            . 'obat apa saja|obat apa aja/u',
            $teks
        );
    }

    private function handleAvailableList($user, Collection $obat)
    {
        $tersedia = $obat->where('stok', '>', 0)->values();

        if ($tersedia->isEmpty()) {
            return $this->sendReply(
                $user,
                "Maaf ya. 🙏 Saat ini belum ada obat aktif "
                . "dan disetujui yang memiliki stok tersedia "
                . "di apotek kami."
            );
        }

        $reply = "Berikut obat yang tersedia saat ini:\n\n";

        foreach ($tersedia as $item) {
            $reply .= "- {$item['nama_obat']} "
                . "(Stok: {$item['stok']} {$item['satuan']})\n";
        }

        $reply .= "\nStok bisa berubah sewaktu-waktu, ya.";

        return $this->sendReply($user, $reply);
    }

    /*
    |--------------------------------------------------------------------------
    | 7. PENCARIAN OBAT TERTENTU
    |--------------------------------------------------------------------------
    */

    private function findMedicineInMessage(
        string $teks,
        Collection $obat
    ): Collection {
        return $obat->filter(function ($item) use ($teks) {
            $nama = $this->normalizeText($item['nama_obat'] ?? '');

            return $nama !== '' && str_contains($teks, $nama);
        })->values();
    }

    private function findMedicineInHistory(
        Collection $riwayat,
        Collection $obat
    ): Collection {
        foreach (
            $riwayat->where('role', 'user')->sortByDesc('id')
            as $pesan
        ) {
            $hasil = $this->findMedicineInMessage(
                $this->normalizeText($pesan->content ?? ''),
                $obat
            );

            if ($hasil->isNotEmpty()) {
                return $hasil;
            }
        }

        return collect();
    }

    private function handleMedicineStock($user, Collection $obatCocok)
    {
        $reply = $obatCocok->map(function ($item) {
            $status = $item['stok'] > 0 ? 'Tersedia' : 'Habis';

            $harga = is_numeric($item['harga_umum'])
                ? 'Rp ' . number_format(
                    (float) $item['harga_umum'],
                    0,
                    ',',
                    '.'
                )
                : 'Belum tercatat';

            return "Nama obat: {$item['nama_obat']}\n"
                . "Status: {$status}\n"
                . "Stok: {$item['stok']} {$item['satuan']}\n"
                . "Harga umum: {$harga}";
        })->implode("\n\n");

        $reply .= "\n\nInformasi diambil dari inventaris terbaru.";

        return $this->sendReply($user, $reply);
    }

    private function isStockOrPriceQuestion(string $teks): bool
    {
        return (bool) preg_match(
            '/stok|harga|ketersediaan|tersedia|ready|habis|kosong|'
            . 'berapa|masih ada|ada nggak|ada gak|ada tidak|'
            . 'jumlahnya|harganya/u',
            $teks
        );
    }

    private function isGeneralStockQuestion(string $teks): bool
    {
        return (bool) preg_match(
            '/stok obat|ketersediaan obat|masih ada obat|'
            . 'ada obat nggak|ada obat gak|ada stok obat|'
            . 'obatnya masih ada/u',
            $teks
        );
    }

    private function hasMedicineReference(string $teks): bool
    {
        return (bool) preg_match(
            '/obatnya|obat itu|yang tadi|obat tersebut|'
            . 'harganya|jumlahnya|stoknya|masih ada/u',
            $teks
        );
    }

    private function handleGeneralStockQuestion($user, Collection $obat)
    {
        $tersedia = $obat->where('stok', '>', 0);

        if ($tersedia->isEmpty()) {
            return $this->sendReply(
                $user,
                'Maaf ya, saat ini belum ada stok obat yang tersedia di apotek kami.'
            );
        }

        return $this->sendReply(
            $user,
            'Ada beberapa obat yang tersedia. 😊 '
            . 'Kamu bisa menyebutkan nama obat yang dicari, '
            . 'atau meminta daftar obat yang tersedia.'
        );
    }

    /*
    |--------------------------------------------------------------------------
    | 8. KONTEKS LANJUTAN STOK
    |--------------------------------------------------------------------------
    */

    private function handleStockFollowUp(
        string $teks,
        Collection $riwayat
    ): ?string {
        $terakhir = $riwayat
            ->where('role', 'assistant')
            ->last();

        if (!$terakhir) {
            return null;
        }

        $jawaban = $this->normalizeText($terakhir->content ?? '');

        $tentangStok = (
            str_contains($jawaban, 'stok')
            && (
                str_contains($jawaban, 'habis')
                || str_contains($jawaban, 'kosong')
                || str_contains($jawaban, 'tersedia')
            )
        );

        if (!$tentangStok) {
            return null;
        }

        if (preg_match(
            '/kok habis|kenapa habis|mengapa habis|'
            . 'kok kosong|kenapa kosong|mengapa kosong|'
            . 'kenapa tidak ada|kok tidak ada/u',
            $teks
        )) {
            return "Maaf banget ya. 😔 Stoknya memang tercatat "
                . "habis di sistem apotek. Aku belum punya "
                . "informasi pasti tentang penyebab atau "
                . "waktu restoknya.";
        }

        if (preg_match('/^(yah+|waduh|aduh|duh|huhu)[!. ]*$/u', $teks)) {
            return "Iya, maaf ya. 😔 Aku paham ini merepotkan. "
                . "Aku belum punya informasi kapan stok akan "
                . "tersedia kembali.";
        }

        if (preg_match('/terus gimana|lalu bagaimana|jadi gimana/u', $teks)) {
            return "Kalau obat itu sedang kamu butuhkan, "
                . "kamu bisa menanyakan ketersediaannya di "
                . "apotek lain atau berkonsultasi dengan "
                . "apoteker mengenai pilihan yang sesuai.";
        }

        return null;
    }

    /*
    |--------------------------------------------------------------------------
    | 9. PERCAKAPAN RINGAN
    |--------------------------------------------------------------------------
    */

    private function handleSmallTalk(string $teks): ?string
    {
        if (preg_match(
            '/^(halo|hai|hi|hey|pagi|selamat pagi|selamat siang|'
            . 'selamat sore|selamat malam)[!. ]*$/u',
            $teks
        )) {
            return 'Hai! 😊 Ada yang bisa aku bantu hari ini?';
        }

        if (preg_match(
            '/^(makasih|terima kasih|thanks|thank you|thx)[!. ]*$/u',
            $teks
        )) {
            return 'Sama-sama! 😊 Semoga membantu, ya.';
        }

        if (preg_match(
            '/apa kabar kamu|kamu gimana|kamu baik-baik saja/u',
            $teks
        )) {
            return 'Aku baik, terima kasih sudah bertanya! 😊 Kamu sendiri bagaimana?';
        }

        if (preg_match(
            '/^(waduh|yah+|aduh|duh|huhu)[!. ]*$/u',
            $teks
        )) {
            return 'Ada apa nih? 😊 Kalau mau cerita, aku siap mendengarkan.';
        }

        if (preg_match(
            '/\b(sedih|kecewa|galau|nangis|menangis)\b/u',
            $teks
        )) {
            return 'Aduh, aku ikut prihatin. ❤️ Kalau kamu nyaman, boleh cerita apa yang sedang terjadi.';
        }

        return null;
    }

    /*
    |--------------------------------------------------------------------------
    | 10. PEMBUKAAN KELUHAN KESEHATAN
    |--------------------------------------------------------------------------
    */

    private function handleHealthOpening(string $teks): ?string
    {
        if (!preg_match(
            '/aku sakit|saya sakit|badanku nggak enak|'
            . 'badan saya tidak enak|aku tidak enak badan|'
            . 'saya tidak enak badan|aku lagi sakit/u',
            $teks
        )) {
            return null;
        }

        if ($this->containsHealthSymptoms($teks)) {
            return null;
        }

        return "Aduh, semoga kamu lekas membaik, ya. ❤️ "
            . "Apa keluhan yang paling terasa sekarang? "
            . "Misalnya pusing, demam, batuk, pilek, mual, "
            . "atau keluhan lainnya.";
    }

    /*
    |--------------------------------------------------------------------------
    | 11. DETEKSI GEJALA
    |--------------------------------------------------------------------------
    */

    private function containsHealthSymptoms(string $teks): bool
    {
        return (bool) preg_match(
            '/demam|panas|pusing|sakit kepala|lemas|lemah|'
            . 'batuk|pilek|mual|muntah|diare|sakit perut|'
            . 'nyeri|gatal|sesak|pegal|menggigil|radang|'
            . 'tenggorokan|bersin|flu|ruam|bengkak|'
            . 'susah tidur|sulit tidur|sembelit|konstipasi/u',
            $teks
        );
    }

    private function getRecentUserConversation(
        Collection $riwayat,
        string $teksSekarang
    ): string {
        $pesan = $riwayat
            ->where('role', 'user')
            ->pluck('content')
            ->take(-8)
            ->toArray();

        $pesan[] = $teksSekarang;

        return $this->normalizeText(implode(' ', $pesan));
    }

    /*
    |--------------------------------------------------------------------------
    | 12. PERCAKAPAN LANJUTAN KESEHATAN
    |--------------------------------------------------------------------------
    */

    private function handleHealthConversation(
        string $teks,
        Collection $riwayat
    ): ?string {
        $konteks = $this->getRecentUserConversation(
            $riwayat,
            $teks
        );

        if (!$this->containsHealthSymptoms($konteks)) {
            return null;
        }

        $adaDemam = preg_match('/demam|badan panas|menggigil/u', $konteks);
        $adaPusing = preg_match('/pusing|sakit kepala|kepala berat/u', $konteks);
        $adaLemas = preg_match('/lemas|lemah|tidak bertenaga/u', $konteks);

        $sudahDitanyaSuhu = $this->assistantAskedAbout(
            $riwayat,
            ['ukur suhu', 'suhu tubuh', 'termometer', 'berapa suhu']
        );

        $sudahMenyebutSuhu = preg_match(
            '/suhu.*\d|\d{2}(?:[.,]\d)?\s*derajat/u',
            $konteks
        );

        if (
            $adaDemam
            && !$sudahMenyebutSuhu
            && !$sudahDitanyaSuhu
        ) {
            return "Aku mengerti. Kalau ada termometer, "
                . "apakah kamu bisa mengukur suhu tubuhmu? "
                . "Tidak apa-apa kalau belum bisa.";
        }

        $sudahDitanyaJenisPusing = $this->assistantAskedAbout(
            $riwayat,
            ['kepala berputar', 'jenis pusing', 'terasa melayang']
        );

        $sudahMenjelaskanPusing = preg_match(
            '/berputar|melayang|mau pingsan|kepala terasa berat/u',
            $konteks
        );

        if (
            $adaPusing
            && !$adaDemam
            && !$sudahDitanyaJenisPusing
            && !$sudahMenjelaskanPusing
        ) {
            return "Pusingnya terasa seperti kepala berputar, "
                . "melayang, atau lebih seperti terasa berat?";
        }

        $sudahDitanyaMakan = $this->assistantAskedAbout(
            $riwayat,
            ['bisa makan', 'bisa minum', 'makan dan minum']
        );

        $sudahMenyebutMakan = preg_match(
            '/makan|minum|nafsu makan|sulit makan|sulit minum/u',
            $konteks
        );

        if (
            ($adaDemam || $adaLemas)
            && !$sudahDitanyaMakan
            && !$sudahMenyebutMakan
        ) {
            return "Apakah kamu masih bisa makan dan minum "
                . "seperti biasanya? Kalau sulit, boleh ceritakan juga.";
        }

        return null;
    }

    private function assistantAskedAbout(
        Collection $riwayat,
        array $kataKunci
    ): bool {
        foreach (
            $riwayat->where('role', 'assistant')->sortByDesc('id')->take(5)
            as $pesan
        ) {
            $isi = $this->normalizeText($pesan->content ?? '');

            foreach ($kataKunci as $kata) {
                if (str_contains($isi, $kata)) {
                    return true;
                }
            }
        }

        return false;
    }

    /*
    |--------------------------------------------------------------------------
    | 13. DETEKSI PERMINTAAN REKOMENDASI
    |--------------------------------------------------------------------------
    */

    private function isMedicineRecommendationQuestion(string $teks): bool
    {
        return (bool) preg_match(
            '/rekomendasi obat|obat apa untuk|obat apa buat|'
            . 'obat apa yang cocok|obat yang cocok|'
            . 'obat buat aku|obat untuk keluhan|obat untuk sakit|'
            . 'obat yang manjur|obat yang ampuh|'
            . 'bisa minum obat apa|sebaiknya minum obat apa|'
            . 'obat apa yang bagus|ada obat untuk|'
            . 'obat apa yang harus diminum|obat apa yang bisa diminum|'
            . 'saran obat|sarankan obat|obat yang pas/u',
            $teks
        );
    }

    /*
    |--------------------------------------------------------------------------
    | 14. REKOMENDASI BERDASARKAN ATURAN TERVERIFIKASI
    |--------------------------------------------------------------------------
    */

    private function handleMedicineRecommendation(
        string $teks,
        Collection $riwayat
    ): string {
        $konteks = $this->getRecentUserConversation(
            $riwayat,
            $teks
        );

        if (!$this->containsHealthSymptoms($konteks)) {
            return "Boleh, aku bantu memahami informasi yang "
                . "perlu diperhatikan. 😊 Keluhan apa yang "
                . "sedang kamu rasakan? Ceritakan gejala "
                . "yang paling mengganggu terlebih dahulu.";
        }

        /*
         * Hanya aturan yang telah diverifikasi yang boleh dipakai.
         * Obat harus aktif dan sudah disetujui.
         */
        $aturan = AturanRekomendasiObat::query()
            ->where('is_verified', true)
            ->with(['obat.kategori'])
            ->get()
            ->filter(function ($item) {
                $obat = $item->obat;

                return $obat
                    && $obat->is_active
                    && $obat->is_approved;
            })
            ->values();

        if ($aturan->isEmpty()) {
            return "Aku sudah memahami keluhan yang kamu "
                . "ceritakan. ❤️ Namun, belum ada aturan "
                . "rekomendasi medis terverifikasi yang "
                . "bisa aku gunakan untuk mencocokkan "
                . "keluhan tersebut.\n\nAku tidak mau "
                . "asal menyarankan obat. Sebaiknya "
                . "diskusikan pilihan obat dengan apoteker "
                . "agar sesuai dan aman untuk kondisimu.";
        }

        /*
         * Cocokkan frasa gejala dengan aturan.
         * Gejala dipisahkan menggunakan koma, titik koma,
         * garis baru, atau tanda | di database.
         */
        $hasil = $aturan->map(function ($item) use ($konteks) {
            $frasa = preg_split(
                '/[,;\n|]+/u',
                $this->normalizeText($item->gejala ?? '')
            );

            $skor = 0;

            foreach ($frasa as $kata) {
                $kata = trim($kata);

                if (mb_strlen($kata) < 3) {
                    continue;
                }

                if (str_contains($konteks, $kata)) {
                    $skor++;
                }
            }

            return [
                'aturan' => $item,
                'skor' => $skor,
            ];
        })
            ->filter(fn ($item) => $item['skor'] > 0)
            ->sortByDesc('skor')
            ->values();

        if ($hasil->isEmpty()) {
            return "Aku belum menemukan aturan rekomendasi "
                . "terverifikasi yang cocok dengan gejala "
                . "yang kamu ceritakan.\n\nBukan berarti "
                . "tidak ada obat yang sesuai, ya. Hanya "
                . "saja aku belum punya dasar yang cukup "
                . "untuk menyebutkan pilihan obat dengan aman. "
                . "Silakan konsultasikan dengan apoteker.";
        }

        /*
         * Hindari menampilkan obat yang sama berulang kali.
         */
        $hasil = $hasil
            ->unique(fn ($item) => $item['aturan']->obat_id)
            ->take(5)
            ->values();

        $tersedia = $hasil->filter(function ($item) {
            return (int) $item['aturan']->obat->stok > 0;
        })->values();

        $habis = $hasil->filter(function ($item) {
            return (int) $item['aturan']->obat->stok <= 0;
        })->values();

        if ($tersedia->isEmpty()) {
            return "Aku menemukan aturan informasi yang "
                . "berkaitan dengan keluhanmu, tetapi obat "
                . "yang cocok berdasarkan aturan tersebut "
                . "belum memiliki stok tersedia di apotek.\n\n"
                . "Aku tidak akan mengganti obat secara "
                . "sembarangan. Kamu bisa membicarakan "
                . "alternatifnya dengan apoteker.";
        }

        $reply = "Aku menemukan beberapa informasi yang "
            . "berkaitan dengan keluhan yang kamu ceritakan. ❤️\n\n";

        $reply .= "Berikut kandidat informasi obat yang "
            . "bisa kamu diskusikan dengan apoteker:\n\n";

        foreach ($tersedia as $index => $item) {
            $aturanObat = $item['aturan'];
            $obat = $aturanObat->obat;

            $reply .= ($index + 1) . ". {$obat->nama_obat}\n";
            $reply .= "   Indikasi dalam data: {$aturanObat->indikasi}\n";
            $reply .= "   Stok: {$obat->stok} {$obat->satuan}\n";

            if ($aturanObat->peringatan) {
                $reply .= "   Peringatan: {$aturanObat->peringatan}\n";
            }

            if ($aturanObat->kontraindikasi) {
                $reply .= "   Perhatian: {$aturanObat->kontraindikasi}\n";
            }

            $reply .= "\n";
        }

        if ($habis->isNotEmpty()) {
            $reply .= "Catatan stok: beberapa obat yang "
                . "berkaitan dengan aturan tersebut sedang "
                . "habis di apotek.\n\n";
        }

        $reply .= "Penting: hasil pencocokan ini bukan "
            . "diagnosis dan bukan resep. Kecocokan obat "
            . "untuk seseorang tetap perlu dinilai oleh "
            . "apoteker atau tenaga kesehatan. Aku tidak "
            . "menentukan dosis atau aturan minum obat.";

        return $reply;
    }

    /*
    |--------------------------------------------------------------------------
    | 15. TANDA BAHAYA KESEHATAN
    |--------------------------------------------------------------------------
    */

    private function hasEmergencySymptoms(string $teks): bool
    {
        $pola = [
            '/sesak napas berat/u',
            '/sulit bernapas/u',
            '/susah bernapas/u',
            '/tidak bisa bernapas/u',
            '/nyeri dada hebat/u',
            '/dada terasa sangat sakit/u',
            '/pingsan/u',
            '/tidak sadarkan diri/u',
            '/kejang/u',
            '/bibir membiru/u',
            '/perdarahan hebat/u',
            '/muntah darah/u',
            '/wajah mencong/u',
            '/lemah mendadak sebelah tubuh/u',
            '/lidah membengkak/u',
            '/tenggorokan membengkak/u',
            '/reaksi alergi berat/u',
        ];

        foreach ($pola as $regex) {
            if (preg_match($regex, $teks)) {
                return true;
            }
        }

        return false;
    }

    private function emergencyReply(): string
    {
        return "Aku khawatir dengan gejala yang kamu "
            . "ceritakan. ❤️ Ini bisa menjadi tanda kondisi "
            . "serius yang membutuhkan pertolongan segera.\n\n"
            . "Tolong segera pergi ke IGD atau hubungi "
            . "layanan darurat setempat. Jika memungkinkan, "
            . "minta orang terdekat untuk menemanimu. "
            . "Jangan menunda pertolongan untuk mencari "
            . "obat melalui chat.";
    }

    /*
    |--------------------------------------------------------------------------
    | 16. SYSTEM PROMPT
    |--------------------------------------------------------------------------
    */

    private function buildSystemPrompt(
        Collection $obat,
        $user = null
    ): string {
        $dataObat = json_encode(
            $obat->all(),
            JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT
        );

        /*
         * Nama diambil langsung dari akun user yang sedang login.
         * Tidak menggunakan pesan chat untuk menentukan nama.
         */
        $namaPengguna = 'belum diketahui';

        if (
            $user !== null
            && isset($user->name)
            && is_string($user->name)
            && trim($user->name) !== ''
        ) {
            $namaPengguna = trim($user->name);
        }

        return <<<PROMPT
Kamu adalah Asisten Apotek, asisten virtual yang ramah,
natural, empatik, sabar, dan bertanggung jawab.

KAMU BUKAN DOKTER DAN BUKAN APOTEKER.
Kamu tidak boleh mendiagnosis atau meresepkan obat.

==================================================
A. IDENTITAS DAN TUJUAN
==================================================

Tugasmu:
1. Membantu pelanggan memperoleh informasi apotek.
2. Menjawab pertanyaan stok dan harga berdasarkan data.
3. Memahami konteks percakapan.
4. Menjelaskan informasi kesehatan umum secara hati-hati.
5. Mengarahkan pelanggan kepada tenaga kesehatan jika diperlukan.
6. Menjaga privasi dan keselamatan pelanggan.

==================================================
B. IDENTITAS PENGGUNA YANG LOGIN
==================================================

Nama pengguna yang sedang login:
{$namaPengguna}

Nama tersebut berasal dari akun pengguna yang sedang login.

Jika pengguna bertanya:
- "Siapa nama aku?"
- "Nama aku siapa?"
- "Kamu tahu nama aku?"
- "Kamu ingat nama saya?"
- atau pertanyaan sejenis,

gunakan nama pengguna di atas.

Jangan meminta pengguna menyebutkan namanya lagi.

Jangan mengarang nama lain.

Jangan menggunakan placeholder seperti:
[NAMA]
[NAME]
<nama>

Jika nama pengguna di atas adalah "belum diketahui",
jangan mengarang nama.

Gunakan nama tersebut secara natural jika memang relevan
dalam percakapan. Jangan memaksakan penggunaan nama
di setiap jawaban.

==================================================
C. PRIVASI
==================================================

Jangan meminta:
- Nama lengkap.
- Umur atau tanggal lahir.
- Alamat.
- Nomor telepon.
- Email.
- Nomor identitas.
- Password.
- Informasi rekening.
- Foto KTP atau dokumen pribadi.

Jangan meminta identitas untuk mengecek stok atau harga.

Tanyakan hanya informasi yang relevan dengan keluhan.
Pelanggan tidak wajib menjawab pertanyaan.

==================================================
D. MEMAHAMI KONTEKS
==================================================

Setiap pesan merupakan bagian dari percakapan.

Contoh:
Pelanggan: Aku sakit kepala.
Pelanggan: Sejak kemarin.
Pelanggan: Badanku juga panas.

Pahami bahwa pelanggan mengalami sakit kepala sejak
kemarin dan juga merasa badannya panas.

Jangan bertanya ulang tentang keluhan yang sudah disebutkan.

Jika pelanggan berkata:
- Obatnya.
- Yang tadi.
- Masih ada?
- Harganya berapa?
- Kalau begitu bagaimana?
- Terus?
- Kenapa begitu?

Gunakan konteks sebelumnya jika jelas.

Jika tidak jelas, tanyakan satu pertanyaan klarifikasi.

Jangan mengarang informasi yang belum diberikan.

==================================================
E. GAYA JAWABAN
==================================================

Jawab sesuai maksud pesan.

Untuk sapaan, balas dengan ramah.

Untuk ucapan terima kasih, balas singkat.

Untuk keluhan kesehatan, tunjukkan empati.

Untuk pelanggan kecewa, jangan mengabaikan perasaannya.

Untuk stok dan harga, jawab langsung berdasarkan inventaris.

Jangan selalu membuka jawaban dengan:
- Tentu saja.
- Baiklah.
- Terima kasih atas pertanyaannya.
- Saya memahami pertanyaan Anda.

Hindari jawaban berulang dan terlalu panjang.

==================================================
F. KESEHATAN
==================================================

Jangan memastikan penyakit hanya dari gejala.

Jangan menyebut diagnosis sebagai kepastian.

Jangan mengatakan obat pasti menyembuhkan.

Jangan menjanjikan kesembuhan.

Jangan mengarang dosis, aturan minum, efek samping,
kontraindikasi, atau interaksi obat.

Jangan memberikan instruksi penggunaan obat yang
tidak didukung sumber tepercaya.

Jika tidak tahu, katakan belum tahu.

Jika informasi belum cukup, jelaskan keterbatasannya.

==================================================
G. REKOMENDASI OBAT
==================================================

Jangan memilih obat hanya karena stoknya tersedia.

Ketersediaan obat tidak membuktikan kecocokan medis.

Jangan menyarankan antibiotik atau obat keras
untuk digunakan sendiri tanpa arahan tenaga kesehatan.

Jangan mengganti obat tanpa dasar medis.

Jika tidak ada data medis terverifikasi, jangan
mengarang indikasi atau kecocokan obat.

Jika ada data indikasi, tetap jelaskan bahwa
pencocokan bukan diagnosis atau resep.

Arahkan pelanggan untuk membahas pilihan obat
dengan apoteker atau tenaga kesehatan.

Jangan memberikan dosis jika tidak ada sumber
dan penilaian profesional yang memadai.

==================================================
H. INVENTARIS
==================================================

Gunakan data inventaris berikut sebagai sumber
informasi stok dan harga:

{$dataObat}

Aturan:
- Stok 0 berarti habis.
- Stok lebih dari 0 berarti tersedia.
- Jangan mengarang stok.
- Jangan mengarang harga.
- Jangan mengarang tanggal restok.
- Jangan menggunakan stok dari ingatan percakapan.
- Jangan menyebut obat yang tidak ada dalam data.
- Jangan menganggap obat tersedia berarti cocok untuk pelanggan.

Jika pelanggan bertanya daftar obat tersedia,
tampilkan hanya obat dengan stok lebih dari nol.

Jika pelanggan bertanya daftar obat habis,
tampilkan hanya obat dengan stok nol.

Jika pelanggan bertanya harga, gunakan harga yang tersedia.
Jika harga tidak tercatat, katakan belum tercatat.

==================================================
I. TANDA BAHAYA
==================================================

Jika ada sesak berat, nyeri dada hebat, pingsan,
kejang, bibir membiru, perdarahan hebat, gejala stroke,
atau reaksi alergi berat, arahkan segera ke IGD
atau layanan darurat setempat.

Jangan menyuruh pelanggan mencoba obat terlebih dahulu.

==================================================
J. FORMAT JAWABAN
==================================================

Percakapan biasa:
1-3 kalimat.

Konsultasi:
- Tunjukkan empati.
- Rangkum hal yang sudah diketahui.
- Tanyakan satu hal yang relevan jika perlu.

Pertanyaan stok:
Jawab langsung.

Jangan mengulang salam.
Jangan mengulang pertanyaan yang sudah dijawab.
Jangan membuat daftar panjang jika tidak diminta.

Jika tidak tahu, katakan tidak tahu.

Utamakan keselamatan pelanggan, privasi,
dan keakuratan informasi.
PROMPT;
    }

    /*
    |--------------------------------------------------------------------------
    | 17. MEMBERSIHKAN JAWABAN
    |--------------------------------------------------------------------------
    */

    private function cleanAIResponse(string $reply): string
    {
        $reply = trim($reply);

        $reply = preg_replace(
            "/\n{3,}/u",
            "\n\n",
            $reply
        );

        return trim($reply);
    }

    /*
    |--------------------------------------------------------------------------
    | 18. SIMPAN DAN KIRIM JAWABAN
    |--------------------------------------------------------------------------
    */

    private function sendReply($user, string $reply)
    {
        AiMessage::create([
            'user_id' => $user->id,
            'role' => 'assistant',
            'content' => $reply,
        ]);

        return response()->json([
            'reply' => $reply,
        ]);
    }

    /*
    |--------------------------------------------------------------------------
    | 19. RIWAYAT CHAT
    |--------------------------------------------------------------------------
    */

    public function history(Request $request)
    {
        $messages = AiMessage::where(
            'user_id',
            $request->user()->id
        )
            ->orderBy('id')
            ->get([
                'id',
                'role',
                'content',
                'created_at',
            ]);

        return response()->json([
            'messages' => $messages,
        ]);
    }

    
}